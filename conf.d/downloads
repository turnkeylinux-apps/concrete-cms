#!/bin/bash -ex

VERSION=9.5.2
TAG="$VERSION"
COMMIT=72f0bf37601073e29b279415be8ea2b6af06efac
SHA256=44ba6f6f23ae19b936f6df9652af07590ef2da64933f24095a9a5e807ce553bb
URL="https://github.com/concretecms/concretecms/releases/download/$TAG/concrete-cms-$VERSION.zip"
SRC=/usr/local/src
ARCHIVE="$SRC/concrete-cms-$VERSION.zip"

proxy=()
[[ -z ${FAB_HTTP_PROXY:-} ]] || proxy=(--proxy "$FAB_HTTP_PROXY")

curl --fail --location --show-error "${proxy[@]}" --output "$ARCHIVE" "$URL"
echo "$SHA256  $ARCHIVE" | sha256sum --check --strict

cat >"$SRC/concrete-cms-release" <<EOF
CONCRETE_CMS_VERSION=$VERSION
CONCRETE_CMS_TAG=$TAG
CONCRETE_CMS_COMMIT=$COMMIT
CONCRETE_CMS_SOURCE_URL=$URL
CONCRETE_CMS_SOURCE_SHA256=$SHA256
EOF
